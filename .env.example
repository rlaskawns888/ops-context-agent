# 실제 값은 .env에만 넣는다. 이 파일에는 키 이름만 둔다.
# 사용법: cp .env.example .env 후 값 채우기

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
# 형식: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# 채팅 모델(AZURE_OPENAI_CHAT_DEPLOYMENT) 단가, USD / 1M 토큰. 비용 계산용 (비우면 토큰만 기록)
LLM_PRICE_INPUT_USD_PER_1M=
LLM_PRICE_CACHED_INPUT_USD_PER_1M=
LLM_PRICE_OUTPUT_USD_PER_1M=

LLM_PRICE_INPUT_USD_PER_1M=
LLM_PRICE_CACHED_INPUT_USD_PER_1M=
LLM_PRICE_OUTPUT_USD_PER_1M=

# --- Neo4j (AuraDB Free) ---
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
# 선택: TLS 체인의 루트 CA를 OS 신뢰 저장소가 모를 때만 설정 (레포 루트 기준 경로, 예: certs/corp-root-ca.pem)
# 설정하면 neo4j+s:// → neo4j:// + encrypted + TrustCustomCAs 로 연결한다. 비우면 URI 그대로 사용.
NEO4J_TRUSTED_CA=

# --- Langfuse ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
